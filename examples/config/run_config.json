{
  "run_metadata": {
    "run_name": "example-single-echo-query",
    "description": "Single-item OpenAI Batch example that echoes query and uses query_id as the canonical row id",
    "tags": [
      "example",
      "openai-batch",
      "gpt-5-mini"
    ]
  },
  "source_input": {
    "path": "../data/mock_data.csv",
    "format": "csv",
    "row_id_column": "query_id"
  },
  "task_kind": "single",
  "task": {
    "import_path": "llm_batch_annotate.SingleTaskBase",
    "settings": {
      "required_input_columns": [
        "query"
      ],
      "unit_field_columns": [
        "query"
      ]
    }
  },
  "builder": {
    "import_path": "llm_batch_annotate.SimpleTemplateBuilder",
    "settings": {
      "required_unit_fields": [
        "query"
      ]
    }
  },
  "parser": {
    "import_path": "llm_batch_annotate.StructuredOutputParser"
  },
  "provider": {
    "component": {
      "import_path": "llm_batch_annotate.OpenAIBatchProvider"
    },
    "config": {
      "provider_kind": "openai_batch",
      "model": "gpt-5-mini",
      "completion_window": "24h",
      "metadata": {
        "example_name": "single_echo_query"
      },
      "request_options": {
        "endpoint": "/v1/responses",
        "api_key_env_var": "OPEN_AI_KEY",
        "timeout_seconds": 10,
        "body": {
          "text": {
            "format": {
              "type": "json_schema",
              "name": "echo_single_query",
              "strict": true,
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "artifact_store": {
    "component": {
      "import_path": "llm_batch_annotate.LocalArtifactStore"
    },
    "config": {
      "kind": "local",
      "root_dir": "../runs"
    }
  },
  "prompt_assets": {
    "asset_root": "..",
    "system_prompt_path": "prompts/prompt_1.txt",
    "user_prompt_template_path": "templates/template_1.txt",
    "response_schema_path": "schemas/prompt_1.schema.json"
  },
  "output": {
    "preserve_raw_outputs": true,
    "write_manifest": true,
    "write_summary": true
  },
  "retry_policy": {
    "enabled": false,
    "max_attempts": 1,
    "retry_failed_requests": false,
    "retry_failed_items": false
  }
}
